; AI Village — first-stage autonomous showcase
config_version=5

[application]
config/name="AI Village — Fountain Commons"
config/version="0.5.0-beta.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1536
window/size/viewport_height=1024
window/size/window_width_override=1200
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.04,0.10,0.12,1)
